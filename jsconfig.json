{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "esnext",
      "dom"
    ],
    "target": "esnext",
    "checkJs": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "src/components/**/*.js",
    "src/pages/**/*.jsx",
    "src/Layout.jsx",
    "src/App.jsx",
    "src/main.jsx",
    "src/components/Login.jsx",
    "src/components/UserNotRegisteredError.jsx",
    "src/components/dashboard/AllocationChart.jsx",
    "src/lib/AuthContext.jsx",
    "src/lib/PageNotFound.jsx",
    "src/lib/query-client.js",
    "src/pages.config.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/vite-plugins",
    "src/components/ui",
    "src/api"
  ]
}
